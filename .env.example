# ===========================================
# NextStep Stock Adjust - Configuration Example
# ===========================================
# Copy this file to .env and update values

# smlnesservice (API Gateway)
# Base URL ของ smlnesservice (NestJS) — ไม่ต้องใส่ trailing slash
SMLNES_BASE_URL=http://localhost:3000
# Raw client token (machine identity) — ต้อง match hash ใน ALLOWED_CLIENTS_JSON
# ของ smlnesservice (clientCode = 'nextstep_stock_adjust')
SMLNES_CLIENT_TOKEN=replace-with-raw-token-from-smlnesservice

# Cookie Security
# Set to "false" when serving over HTTP or behind a reverse proxy that does not forward HTTPS.
COOKIE_SECURE=false
# Required in production. Use a long random value; changing it logs everyone out.
SESSION_SECRET=replace-with-a-long-random-secret

# Application Settings
NEXT_PUBLIC_APP_NAME=NextStep Stock Adjust
NEXT_PUBLIC_APP_VERSION=1.3.0
